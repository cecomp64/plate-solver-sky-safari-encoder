# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
build/

# Config with real site location / secrets
config/config.yaml

# Persisted active-location selection (runtime state, not source)
state/

# Frames saved by failed_frames in config.yaml (diagnostics, not source)
failed_frames/

# Generated star databases (large, machine-specific)
*.npz
!config/*.example.yaml

# Generated test images (regenerate with scripts/generate_test_image.py)
#test_images/

# Local systemd overrides
systemd/*.local.service

# OS
.DS_Store

# Local restore points of config + uncommitted code (see snapshots/*/README)
snapshots/
